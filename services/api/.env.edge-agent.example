# Standalone FactoryOS Edge Agent process configuration.
# Template only: use the deployment secret manager or mounted secrets at runtime.
# Do not commit real device tokens, local bearer tokens or encryption keys.

EDGE_API_BASE_URL=https://factoryos.example.com
EDGE_DEVICE_ID=REPLACE_WITH_REGISTERED_DEVICE_UUID
EDGE_DEVICE_TOKEN=REPLACE_WITH_ONE_TIME_ISSUED_DEVICE_TOKEN
EDGE_AGENT_LOCAL_TOKEN=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES

# REQUIRED: canonical base64 encoding of exactly 32 random bytes.
# Keep the AES-256-GCM spool key separate from EDGE_AGENT_LOCAL_TOKEN.
# Load from a deployment secret manager; do not place it in the spool directory.
EDGE_SPOOL_ENCRYPTION_KEY=REPLACE_WITH_CANONICAL_BASE64_KEY
EDGE_SPOOL_DIR=/var/lib/factoryos-edge/spool
EDGE_SPOOL_MAX_BYTES=536870912

# Local API accepts only loopback connections.
EDGE_AGENT_PORT=8787
EDGE_SYNC_POLL_INTERVAL_MS=5000
EDGE_SYNC_TIMEOUT_MS=10000
EDGE_AGENT_VERSION=1.0.0
EDGE_HEALTH_REPORT_INTERVAL_MS=30000

# Only explicitly configured package/version/use-case scopes are polled.
# Unlisted packages, stale controls, and failed validation fail closed.
EDGE_MANAGED_PACKAGES_JSON=[{"package_id":"quality-defect","package_version":"1.2.0","use_case_id":"quality-inspection"}]
EDGE_PACKAGE_CONTROL_POLL_INTERVAL_MS=30000
EDGE_PACKAGE_SIGNING_KEY_POLL_INTERVAL_MS=60000
EDGE_MODEL_VERSIONS_JSON={}
EDGE_CAPABILITIES_JSON={"runtime":"node"}
