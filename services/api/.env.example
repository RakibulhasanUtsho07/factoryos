NODE_ENV=development

PORT=3001

# Comma-separated browser origins allowed to call the API.
# In production, use exact deployed HTTPS origins; do not use '*'.
CORS_ORIGINS=http://localhost:3000

# Swagger is enabled locally and disabled by default in production.
SWAGGER_ENABLED=true

# ------------------------------------------------------------
# Runtime application connection
#
# IMPORTANT:
# Use the least-privileged application role.
# Do NOT use the PostgreSQL superuser here.
# ------------------------------------------------------------

DATABASE_URL=postgresql://factoryos_app:CHANGE_ME@localhost:5432/factoryos

# ------------------------------------------------------------
# Integration-test fixture connection
#
# Used only by PostgreSQL integration tests for fixture setup,
# assertions and cleanup.
#
# Do NOT use this as the API runtime connection.
# ------------------------------------------------------------

TEST_ADMIN_DATABASE_URL=postgresql://factoryos:CHANGE_ME@localhost:5432/factoryos

# ------------------------------------------------------------
# Authentication
#
# dev = local-only development JWT; never use in deployed production
# oidc = production OIDC/JWKS JWT
#
# Production requires NODE_ENV=production and AUTH_MODE=oidc. Startup fails closed
# when runtime environment/auth mode are missing or invalid. OIDC_ISSUER and
# OIDC_JWKS_URI must be HTTPS URLs without embedded credentials in production.
# DEV_AUTH_ENABLED must not be true in production. Keep real values in a secret
# manager/workload identity, never in this example or a committed .env file.
# ------------------------------------------------------------

AUTH_MODE=dev

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

JWT_ISSUER=factoryos-api

JWT_AUDIENCE=factoryos-web

DEV_AUTH_ENABLED=true

DEV_AUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# ------------------------------------------------------------
# Production OIDC
# ------------------------------------------------------------

OIDC_ISSUER=

OIDC_AUDIENCE=

OIDC_JWKS_URI=

# ------------------------------------------------------------
# Outbox
# ------------------------------------------------------------

OUTBOX_DISPATCHER_ENABLED=true

# ------------------------------------------------------------
# Durable event-bus transport
#
# Local mode only writes a log and is not durable. Production startup
# requires OUTBOX_TRANSPORT=kafka. Provision topics separately.
# For Kafka-compatible local development, see deploy/event-bus/compose.yaml.
# ------------------------------------------------------------

OUTBOX_TRANSPORT=local
KAFKA_BROKERS=127.0.0.1:19092
KAFKA_CLIENT_ID=factoryos-api
KAFKA_TOPIC=factoryos.domain-events
KAFKA_DLQ_TOPIC=factoryos.domain-events.dlq
KAFKA_CONSUMER_GROUP_ID=factoryos-api-consumers-v1
KAFKA_CONSUMER_MAX_ATTEMPTS=5
KAFKA_CONSUMER_RETRY_BASE_MS=200
KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_SSL=false
# Production must set KAFKA_SSL=true and use secret-manager-backed SASL values.
# Supported SASL mechanisms: plain, scram-sha-256, scram-sha-512.
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ------------------------------------------------------------
# Finance ERP outbound network policy (production)
#
# Both lists are mandatory for the pinned Business Central REST adapter.
# Use exact DNS hostnames and every expected public A/AAAA address. Keep entries
# synchronized with the provider's approved change window; private, link-local,
# metadata, reserved and unexpected addresses are always rejected.
# Actual access tokens must come from a registered FinanceSecretManager provider,
# using workload identity/secret-manager IAM; this file never contains a secret.
# Business Central REST adapter contract: docs/finance-erp-production-connectors.md
# ------------------------------------------------------------

FINANCE_ERP_ALLOWED_HOSTS=
FINANCE_ERP_ALLOWED_IPS=

# HashiCorp Vault KV-v2 integration for ERP OAuth access tokens.
# Mount a short-lived Vault Agent token file using workload identity; never set
# a static Vault token here. Keep Vault's network allowlists separate from ERP.
FINANCE_VAULT_ADDR=
FINANCE_VAULT_TOKEN_FILE=
FINANCE_VAULT_KV_MOUNT=secret
FINANCE_VAULT_ALLOWED_SECRET_PREFIXES=factoryos/prod
FINANCE_VAULT_ALLOWED_HOSTS=
FINANCE_VAULT_ALLOWED_IPS=

# ------------------------------------------------------------
# Distributed tracing and operational metrics
# ------------------------------------------------------------

# Optional OTLP/HTTP collector. Must end in /v1/traces; remote production
# endpoints must use HTTPS. Leave blank to disable trace export.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Optional collector bearer token. Store real values only in a secret manager.
OTEL_EXPORTER_OTLP_TRACES_TOKEN=
OTEL_SERVICE_NAME=factoryos-api
# Root-trace sampling ratio in [0, 1]; valid upstream W3C decisions are respected.
TRACE_SAMPLE_RATIO=0.1

# Prometheus scrape endpoint GET /internal/metrics is disabled when unset.
# Configure a high-entropy secret (32+ characters) out of band in production.
METRICS_SCRAPE_TOKEN=
