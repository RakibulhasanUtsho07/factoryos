NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://factoryos:factoryos_dev_password@localhost:5432/factoryos

# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------

# dev = local development JWT
# oidc = production OIDC/JWKS JWT
AUTH_MODE=dev

JWT_SECRET=

JWT_ISSUER=factoryos-api
JWT_AUDIENCE=factoryos-web

DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=

# ------------------------------------------------------------
# Production OIDC
# ------------------------------------------------------------

OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=