NODE_ENV=development

PORT=3001

# Comma-separated browser origins allowed to call the API.
# In production, use exact deployed HTTPS origins; do not use '*'.
CORS_ORIGINS=http://localhost:3000

# Swagger is enabled locally and disabled by default in production.
SWAGGER_ENABLED=true

# ------------------------------------------------------------
# Runtime application connection
#
# IMPORTANT:
# Use the least-privileged application role.
# Do NOT use the PostgreSQL superuser here.
# ------------------------------------------------------------

DATABASE_URL=postgresql://factoryos_app:CHANGE_ME@localhost:5432/factoryos

# ------------------------------------------------------------
# Integration-test fixture connection
#
# Used only by PostgreSQL integration tests for fixture setup,
# assertions and cleanup.
#
# Do NOT use this as the API runtime connection.
# ------------------------------------------------------------

TEST_ADMIN_DATABASE_URL=postgresql://factoryos:CHANGE_ME@localhost:5432/factoryos

# ------------------------------------------------------------
# Authentication
#
# dev = local-only development JWT; never use in deployed production
# oidc = production OIDC/JWKS JWT
#
# Production requires NODE_ENV=production and AUTH_MODE=oidc. Startup fails closed
# when runtime environment/auth mode are missing or invalid. OIDC_ISSUER and
# OIDC_JWKS_URI must be HTTPS URLs without embedded credentials in production.
# DEV_AUTH_ENABLED must not be true in production. Keep real values in a secret
# manager/workload identity, never in this example or a committed .env file.
# ------------------------------------------------------------

AUTH_MODE=dev

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

JWT_ISSUER=factoryos-api

JWT_AUDIENCE=factoryos-web

DEV_AUTH_ENABLED=true

DEV_AUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# ------------------------------------------------------------
# Production OIDC
# ------------------------------------------------------------

OIDC_ISSUER=

OIDC_AUDIENCE=

OIDC_JWKS_URI=

# ------------------------------------------------------------
# Outbox
# ------------------------------------------------------------

OUTBOX_DISPATCHER_ENABLED=true

# ------------------------------------------------------------
# Durable event-bus transport
#
# Local mode only writes a log and is not durable. Production startup
# requires OUTBOX_TRANSPORT=kafka. Provision the topics separately.
# For local Kafka-compatible development, see deploy/event-bus/compose.yaml.
# ------------------------------------------------------------

OUTBOX_TRANSPORT=local
KAFKA_BROKERS=127.0.0.1:19092
KAFKA_CLIENT_ID=factoryos-api
KAFKA_TOPIC=factoryos.domain-events
KAFKA_DLQ_TOPIC=factoryos.domain-events.dlq
KAFKA_CONSUMER_GROUP_ID=factoryos-api-consumers-v1
KAFKA_CONSUMER_MAX_ATTEMPTS=5
KAFKA_CONSUMER_RETRY_BASE_MS=200
KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_SSL=false
# For deployed environments, set KAFKA_SSL=true and use secret-manager-backed SASL values.
# Supported mechanisms: plain, scram-sha-256, scram-sha-512.
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ------------------------------------------------------------
# Finance ERP outbound network policy (production)
#
# Both lists are mandatory for the pinned Business Central REST adapter.
# Use exact DNS hostnames and every expected public A/AAAA address. Keep entries
# synchronized with the provider's approved change window; private, link-local,
# metadata, reserved and unexpected addresses are always rejected.
# Actual access tokens must come from a registered FinanceSecretManager provider,
# using workload identity/secret-manager IAM; this file never contains a secret.
# Business Central REST adapter contract: docs/finance-erp-production-connectors.md
# ------------------------------------------------------------

FINANCE_ERP_ALLOWED_HOSTS=
FINANCE_ERP_ALLOWED_IPS=

# HashiCorp Vault KV-v2 integration for ERP OAuth access tokens.
# Mount a short-lived Vault Agent token file using workload identity; never set
# a static Vault token here. Keep Vault's network allowlists separate from ERP.
FINANCE_VAULT_ADDR=
FINANCE_VAULT_TOKEN_FILE=
FINANCE_VAULT_KV_MOUNT=secret
FINANCE_VAULT_ALLOWED_SECRET_PREFIXES=factoryos/prod
FINANCE_VAULT_ALLOWED_HOSTS=
FINANCE_VAULT_ALLOWED_IPS=

# OpenSSH SFTP transport. Install openssh-client in the production API image.
# Exact host names and all expected public resolved IPs are required. The SFTP
# connector host_key_sha256 pin must match a key observed by ssh-keyscan before
# strict-host-key-checked transfer. Vault KV-v2 data requires sftp_private_key_pem.
FINANCE_SFTP_ALLOWED_HOSTS=
FINANCE_SFTP_ALLOWED_IPS=

# ------------------------------------------------------------
# Distributed tracing and operational metrics
# ------------------------------------------------------------

# Optional OTLP/HTTP collector. Must end in /v1/traces; remote production
# endpoints must use HTTPS. Leave blank to disable trace export.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Optional collector bearer token. Store real values only in a secret manager.
OTEL_EXPORTER_OTLP_TRACES_TOKEN=
OTEL_SERVICE_NAME=factoryos-api
# Root-trace sampling ratio in [0, 1]; valid upstream W3C decisions are respected.
TRACE_SAMPLE_RATIO=0.1

# Prometheus scrape endpoint GET /internal/metrics is disabled when unset.
# Configure a high-entropy secret (32+ characters) out of band in production.
METRICS_SCRAPE_TOKEN=

# ------------------------------------------------------------
# Tenant-scoped Redis cache + external-erasure adapter
#
# All application cache reads/writes MUST go through TenantCacheService.
# Physical keys are factoryos:tenant:{tenant UUID}:{category}:{SHA-256(logical key)};
# raw logical identifiers are not persisted in Redis or in erasure evidence.
# Per-category erasure fences are non-expiring and use atomic Lua checks.
# Production requires TLS (rediss://), a standalone primary with no unenumerated
# replicas, maxmemory-policy=noeviction, appendonly=yes, appendfsync=always,
# and a secret-manager-backed ACL user. Synchronous AOF is required because a
# lost fence after restart could otherwise allow an erased tenant to be repopulated.
# Redis Cluster/replica topologies are rejected until every node/copy has an
# independently reviewed adapter. Do not reuse this database with unrelated
# tenants/apps or allow application code to write directly to the namespace.
# ------------------------------------------------------------
FACTORYOS_CACHE_CONFIG_REFERENCE=
FACTORYOS_CACHE_URL=
FACTORYOS_CACHE_CONNECT_TIMEOUT_MS=5000

# ------------------------------------------------------------
# WMS proof-of-delivery object verification (S3-compatible)
#
# DELIVERED carrier webhooks fail closed until these settings are provided.
# The API retrieves the configured object and computes SHA-256 over the bytes;
# it never accepts the carrier-supplied digest without checking the stored file.
# Keep credentials in a secret manager/workload identity, not in .env committed to Git.
# Production endpoints must use HTTPS. The POD S3 erasure adapter is deliberately
# narrow: target store_kind=OBJECT_STORAGE, adapter_key=wms.pod.s3.v1, and categories
# exactly EVIDENCE. It is inactive unless the reviewed target config_reference
# exactly matches WMS_POD_STORAGE_CONFIG_REFERENCE. It enumerates only
# pod/{tenant UUID}/{factory UUID}/{shipment UUID}/{object UUID}, refuses versioned
# buckets, and deletes only after a durable sealed resource manifest and intent.
# Never copy a production config reference or credentials into this example file.
# ------------------------------------------------------------
WMS_POD_STORAGE_CONFIG_REFERENCE=
WMS_POD_STORAGE_ENDPOINT=
WMS_POD_STORAGE_BUCKET=
WMS_POD_STORAGE_REGION=
WMS_POD_STORAGE_ACCESS_KEY_ID=
WMS_POD_STORAGE_SECRET_ACCESS_KEY=
WMS_POD_STORAGE_SESSION_TOKEN=
WMS_POD_STORAGE_MAX_BYTES=10485760
WMS_POD_STORAGE_TIMEOUT_MS=5000

# ------------------------------------------------------------
# Tenant-exclusive S3 backup archive + version-level erasure
#
# This adapter is only for independently tenant/category-scoped backup objects
# under factoryos-backups/{tenant UUID}/{DATASET_CATEGORY}/... in a dedicated
# bucket. It requires bucket versioning AND Object Lock to be enabled and checks
# every version's legal hold/retention before deleting exact version IDs.
# It does not cover monolithic database dumps, filesystem/volume snapshots,
# backup vaults, replicas, or disaster-recovery copies outside this bucket.
# The target is active only when config_reference exactly matches the reviewed
# FACTORYOS_BACKUP_STORAGE_CONFIG_REFERENCE. Keep all credentials in a secret
# manager/workload identity; never put production values in this file.
# ------------------------------------------------------------
FACTORYOS_BACKUP_STORAGE_CONFIG_REFERENCE=
FACTORYOS_BACKUP_STORAGE_ENDPOINT=
FACTORYOS_BACKUP_STORAGE_BUCKET=
FACTORYOS_BACKUP_STORAGE_REGION=
FACTORYOS_BACKUP_STORAGE_ACCESS_KEY_ID=
FACTORYOS_BACKUP_STORAGE_SECRET_ACCESS_KEY=
FACTORYOS_BACKUP_STORAGE_SESSION_TOKEN=
FACTORYOS_BACKUP_STORAGE_MAX_OBJECT_BYTES=1073741824
FACTORYOS_BACKUP_STORAGE_TIMEOUT_MS=10000

# S3 bucket-policy writer-fence control plane. Disabled by default.
# Use a SEPARATE least-privilege policy credential (not the object-delete credential).
# Enable only after the infrastructure owner confirms this controller is the exclusive
# writer of the bucket policy and every backup producer is integrated/reviewed.
FACTORYOS_BACKUP_STORAGE_POLICY_CONTROLLER_ENABLED=false
FACTORYOS_BACKUP_STORAGE_POLICY_OWNERSHIP_ACKNOWLEDGED=false
FACTORYOS_BACKUP_STORAGE_POLICY_CONFIG_REFERENCE=
FACTORYOS_BACKUP_STORAGE_POLICY_ACCESS_KEY_ID=
FACTORYOS_BACKUP_STORAGE_POLICY_SECRET_ACCESS_KEY=
FACTORYOS_BACKUP_STORAGE_POLICY_SESSION_TOKEN=

# Required before BACKUP targets can be activated for propagation. These must
# refer to independently reviewed evidence in the deployment evidence system;
# setting a flag/reference is an assertion, not a substitute for actual staging.
FACTORYOS_BACKUP_STORAGE_ERASURE_RUNNER_ENABLED=false
# Writer identity evidence is submitted and independently reviewed in the tenant-scoped inventory API.
# These three references are deployment-controlled acceptance records, not writer inventory data.
FACTORYOS_BACKUP_STORAGE_POLICY_OWNERSHIP_REVIEW_REFERENCE=
FACTORYOS_BACKUP_STORAGE_STAGING_ACCEPTANCE_REFERENCE=
FACTORYOS_BACKUP_STORAGE_RESTORE_REPLAY_REFERENCE=
# Runtime writer fencing is wired into the propagation runner, but production use remains
# disabled by default until every backup producer, provider policy ownership, actual-provider
# staging and restore/tombstone replay have independently reviewed evidence. A flag alone is not proof.

# Non-secret immutable identifiers for the exact accepted provider/account/bucket scope.
# The provider scope reference must not be reused for a different account, region or bucket.
FACTORYOS_BACKUP_STORAGE_PROVIDER_REFERENCE=
FACTORYOS_BACKUP_STORAGE_PROVIDER_SCOPE_REFERENCE=

# Signed backup-copy-class evidence (empty trust store deliberately fails closed).
# Configure deployment-controlled Ed25519 PUBLIC keys and owner references after verification.
# Use deploy/security/backup-copy-evidence-trust.env.example as the shape reference.
# Private signing keys must never be configured in the API process.
# Absolute, API-readable, deployment-owned evidence root mounted read-only.
# Each evidence_reference is a single opaque filename beneath this directory (no URLs/paths).
# Submission, review and propagation verify file bytes against evidence_sha256; unset disables acceptance.
FACTORYOS_BACKUP_COPY_EVIDENCE_ROOT_DIR=
FACTORYOS_BACKUP_COPY_EVIDENCE_TRUSTED_KEYS_JSON=[]

# Independent Ed25519 public keys for external inventory source collectors.
# JSON array records: keyId, ownerReference, sourceKinds allowlist, publicKeyPem.
# API receives public keys only; keep private collector keys in the isolated collector environment.
# Empty disables UNCLASSIFIED_EXTERNAL_STORE NOT_APPLICABLE acceptance (fail closed).
FACTORYOS_EXTERNAL_INVENTORY_SOURCE_TRUSTED_KEYS_JSON=[]
