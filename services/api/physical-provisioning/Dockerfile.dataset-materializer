FROM node:24-alpine

ENV NODE_ENV=production
WORKDIR /opt/factoryos
COPY dataset-materializer.mjs /opt/factoryos/dataset-materializer.mjs

RUN addgroup -S -g 10001 factoryos \
  && adduser -S -D -H -u 10001 -G factoryos factoryos

USER 10001:10001
ENTRYPOINT ["node", "/opt/factoryos/dataset-materializer.mjs"]
