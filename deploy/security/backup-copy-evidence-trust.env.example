# Example only; copy into the API runtime environment after owner/key review.
# This file intentionally contains no real or generated trust key and cannot enable signing.
FACTORYOS_BACKUP_COPY_EVIDENCE_TRUSTED_KEYS_JSON=[]
# Leave unset until a deployment-owned, read-only, evidence artifact directory is mounted.
FACTORYOS_BACKUP_COPY_EVIDENCE_ROOT_DIR=
# Separate Ed25519 PUBLIC-key registry for signed external inventory source receipts.
# Key records contain keyId, ownerReference, sourceKinds (allowlist), publicKeyPem.
# Do not reuse the outer evidence-owner key unless the security owner explicitly approves it.
# Empty deliberately fails closed for UNCLASSIFIED_EXTERNAL_STORE NOT_APPLICABLE claims.
FACTORYOS_EXTERNAL_INVENTORY_SOURCE_TRUSTED_KEYS_JSON=[]
