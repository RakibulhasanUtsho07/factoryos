{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOrganizationAccounts",
      "Effect": "Allow",
      "Action": "organizations:ListAccounts",
      "Resource": "*"
    },
    {
      "Sid": "AssumeOnlyFactoryOSRdsPitrInventoryRoles",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::*:role/FactoryOSRdsPitrReadOnly",
        "arn:aws:iam::*:role/FactoryOSRdsDbPrincipalReader",
        "arn:aws:iam::*:role/FactoryOSIamPrincipalReader",
        "arn:aws-us-gov:iam::*:role/FactoryOSRdsPitrReadOnly",
        "arn:aws-us-gov:iam::*:role/FactoryOSRdsDbPrincipalReader",
        "arn:aws-us-gov:iam::*:role/FactoryOSIamPrincipalReader",
        "arn:aws-cn:iam::*:role/FactoryOSRdsPitrReadOnly",
        "arn:aws-cn:iam::*:role/FactoryOSRdsDbPrincipalReader",
        "arn:aws-cn:iam::*:role/FactoryOSIamPrincipalReader"
      ]
    }
  ]
}
