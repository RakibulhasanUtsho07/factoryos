{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TrustOnlyTheFactoryOSInventorySource",
      "Effect": "Allow",
      "Principal": {
        "AWS": "<FACTORYOS_SOURCE_ROLE_ARN>"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "<UNIQUE_EXTERNAL_ID>"
        }
      }
    }
  ]
}
