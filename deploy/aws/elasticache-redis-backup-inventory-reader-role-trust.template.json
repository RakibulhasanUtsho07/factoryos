{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TrustOnlyTheApprovedFactoryOSInventorySource",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:<PARTITION>:iam::<ORGANIZATION_ACCOUNT_ID>:role/<FACTORYOS_SOURCE_ROLE_NAME>"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "<UNIQUE_EXTERNAL_ID>"
        }
      }
    }
  ]
}
