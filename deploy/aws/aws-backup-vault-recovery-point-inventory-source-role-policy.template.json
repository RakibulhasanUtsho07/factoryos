{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeOnlyTheDedicatedAwsBackupInventoryReaderInApprovedTargetAccount",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::<TARGET_ACCOUNT_ID>:role/FactoryOSAwsBackupInventoryReader",
        "arn:aws-us-gov:iam::<TARGET_ACCOUNT_ID>:role/FactoryOSAwsBackupInventoryReader",
        "arn:aws-cn:iam::<TARGET_ACCOUNT_ID>:role/FactoryOSAwsBackupInventoryReader"
      ]
    }
  ]
}
