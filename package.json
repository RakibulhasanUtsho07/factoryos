{
  "name": "factoryos",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces"
  },
  "overrides": {
    "handlebars": "4.7.10",
    "tmp": "0.2.7",
    "undici": "6.29.0",
    "argparse": "2.0.1"
  }
}
